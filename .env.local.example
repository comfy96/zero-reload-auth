# ------------------------------------------------------------------
# Zero Reload Auth Dashboard: environment variables
# ------------------------------------------------------------------
# 1. Copy this file:            cp .env.local.example .env.local
# 2. Open your Supabase project → Project Settings → API
# 3. Paste the values below, then restart `npm run dev`
#
# Both values are PUBLIC by design (the NEXT_PUBLIC_ prefix ships them
# to the browser). Row Level Security protects your data, not this key.
# NEVER put the `service_role` key in this file or in any NEXT_PUBLIC_ var.
# ------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "publishable" public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
